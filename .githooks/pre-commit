#!/bin/sh
#
# A commit has to stand on its own: the documents must name the version the bundle carries, and the
# lines being committed must pass the linters. See scripts/release.sh and scripts/lint.py.
#
# Bypass with: git commit --no-verify
#
set -eu

root=$(git rev-parse --show-toplevel)
"$root/scripts/release.sh" --check
"$root/scripts/lint.py" --staged
