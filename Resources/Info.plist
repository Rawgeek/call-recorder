<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Call Recorder</string>
	<key>CFBundleExecutable</key>
	<string>CallRecorder</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>local.callrecorder.app</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Call Recorder</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.45</string>
	<key>CFBundleVersion</key>
	<string>136</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- A speech endpoint on a private network is usually plain http: the Mac Studio this app
		     was built for has no certificate, and its address is a Tailscale IP rather than a
		     hostname ATS can except. The pane recommends https outside a private network. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Call Recorder captures your microphone when recording a call.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Call Recorder captures system audio and, when enabled, saves screenshots during calls.</string>
</dict>
</plist>
